// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Branch {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(255)
  address     String?  @db.VarChar(255)
  latitude    Float?   @db.DoublePrecision
  longitude   Float?   @db.DoublePrecision
  is_active   Boolean  @default(true)
  is_archived Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamp(0) @map("created_at")
  updatedAt   DateTime @updatedAt @db.Timestamp(0) @map("updated_at")

  users         User[]
  customers     Customer[]
  conversations Conversation[]
  orders        Order[]
  tickets       Ticket[]
  menus         Menu[]
  tables        Table[]
  staffProfiles StaffProfile[]
  voiceChannels VoiceChannel[]
  staffs        Staff[]

  @@map("branches")
}

model Staff {
  id         Int      @id @default(autoincrement())
  fullName   String?  @db.VarChar(255) @map("full_name")
  email      String   @unique @db.VarChar(255)
  phone      String?  @db.VarChar(50)
  password   String?  @db.VarChar(255)
  role       String?  @default("staff") @db.VarChar(50)
  branch_id  Int?
  branch     Branch?  @relation(fields: [branch_id], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now()) @db.Timestamp(0) @map("created_at")
  updatedAt  DateTime @updatedAt @db.Timestamp(0) @map("updated_at")

  @@map("staffs")
  @@index([branch_id])
}

model Conversation {
  id                Int       @id @default(autoincrement())
  phone             String?   @db.VarChar(255)
  name              String?   @db.VarChar(255)
  platform          String?   @default("whatsapp") @db.VarChar(50)
  platform_user_id  String?   @db.VarChar(255) @map("platform_user_id")
  status            String?   @default("OPEN") @db.VarChar(50)
  assigned_staff_id Int?      @map("assigned_staff_id")
  last_message_at   DateTime? @db.Timestamp(0) @map("last_message_at")
  last_viewed       DateTime? @db.Timestamp(0)
  created_at        DateTime  @default(now()) @db.Timestamp(0)
  updated_at        DateTime? @updatedAt @db.Timestamp(0) @map("updated_at")
  branch_id         Int?
  customer_id       Int?
  order_id          Int?      @map("order_id")

  branch           Branch? @relation(fields: [branch_id], references: [id], onDelete: SetNull)
  customer         Customer? @relation(fields: [customer_id], references: [id], onDelete: SetNull)
  messages         Message[]
  replies          Reply[]
  aiMessages       AiMessage[]
  staffMessages    StaffMessage[]
  aiReplies        AiReply[]
  staffReplies     StaffReply[]
  resolved         Resolved?
  escalations      Escalation?
  aiFeedback       AiFeedback[]
  deliveryIssues   DeliveryIssue[]
  orders           Order[]
  

  @@map("conversations")
  @@index([branch_id])
  @@index([customer_id])
  @@index([platform_user_id])
  @@index([status])
}

model ChatSession {
  id               Int      @id @default(autoincrement())
  platform         String   @db.VarChar(50)
  platform_user_id String   @db.VarChar(255) @map("platform_user_id")
  state            String   @default("WAITING_FOR_BRANCH") @db.VarChar(50)
  pending_messages String?  @db.Text @map("pending_messages")
  expires_at       DateTime @db.Timestamp(0) @map("expires_at")
  created_at       DateTime @default(now()) @db.Timestamp(0) @map("created_at")
  updated_at       DateTime @updatedAt @db.Timestamp(0) @map("updated_at")

  @@map("chat_sessions")
  @@index([platform_user_id])
  @@index([state])
  @@index([expires_at])
}

model Customer {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(255)
  phone     String?  @db.VarChar(255)
  createdAt DateTime @default(now()) @db.Timestamp(0) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamp(0) @map("updated_at")
  branch_id Int?

  conversations Conversation[]
  branch       Branch? @relation(fields: [branch_id], references: [id], onDelete: SetNull)

  @@map("customers")
  @@index([branch_id])
}

model Message {
  id               Int       @id @default(autoincrement())
  conversation_id  Int
  sender           String    @db.VarChar(50)
  message          String?   @db.Text
  created_at       DateTime  @default(now()) @db.Timestamp(0)

  conversation     Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@map("messages")
}

model Reply {
  id               Int       @id @default(autoincrement())
  conversation_id  Int
  sender           String    @db.VarChar(50)
  message          String?   @db.Text
  user_id          Int?
  created_at       DateTime  @default(now()) @db.Timestamp(0)

  conversation     Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@map("replies")
}

model AiMessage {
  id               Int       @id @default(autoincrement())
  conversation_id  Int
  sender           String    @db.VarChar(255)
  message          String?   @db.Text
  user_id          Int?
  created_at       DateTime  @default(now()) @db.Timestamp(0)

  conversation     Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@map("ai_messages")
}

model StaffMessage {
  id               Int       @id @default(autoincrement())
  conversation_id  Int
  sender           String    @db.VarChar(255)
  message          String?   @db.Text
  user_id          Int?
  created_at       DateTime  @default(now()) @db.Timestamp(0)

  conversation     Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@map("staff_messages")
}

model AiReply {
  id               Int       @id @default(autoincrement())
  conversation_id  Int
  sender           String    @db.VarChar(255)
  message          String?   @db.Text
  user_id          Int?
  created_at       DateTime  @default(now()) @db.Timestamp(0)

  conversation     Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@map("ai replies")
}

model StaffReply {
  id               Int       @id @default(autoincrement())
  conversation_id  Int
  sender           String    @db.VarChar(255)
  message          String?   @db.Text
  user_id          Int?
  created_at       DateTime  @default(now()) @db.Timestamp(0)

  conversation     Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@map("staff replies")
}

model Resolved {
  id               Int       @id @default(autoincrement())
  conversation_id  Int       @unique
  resolved_at      DateTime  @default(now()) @db.Timestamp(0)

  conversation     Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@map("resolved")
}

model Escalation {
  id               Int       @id @default(autoincrement())
  conversation_id  Int       @unique
  customer_name    String?   @db.VarChar(255)
  escalated_at     DateTime  @default(now()) @db.Timestamp(0)
  claimed_by       String?   @db.VarChar(255)
  claim_time       DateTime? @db.Timestamp(0)
  snoozed_until    DateTime? @db.Timestamp(0)
  alarm_active     Boolean?  @default(true)
  assigned_staff_id Int?
  customer_id      Int?
  branch_id        Int?
  escalation_reason String?  @db.VarChar(255)
  detected_intent  String?   @db.VarChar(255)
  ai_confidence    Float?
  original_message String?   @db.Text
  status           String?   @db.VarChar(50)

  conversation     Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@map("escalations")
}

model Refund {
  id               Int       @id @default(autoincrement())
  refund_number    String?   @unique @db.VarChar(255)
  order_id         String?   @db.VarChar(255)
  customer_name    String?   @db.VarChar(255)
  requested_by     String?   @db.VarChar(255)
  approved_by      String?   @db.VarChar(255)
  completed_by     String?   @db.VarChar(255)
  status           String    @default("pending") @db.VarChar(50)
  refund_type      String    @default("full") @db.VarChar(50)
  refund_method    String?   @db.VarChar(50)
  refund_reason    String?   @db.Text
  manager_notes    String?   @db.Text
  refund_amount    Decimal?  @db.Decimal(10, 2)
  payment_reference String?  @db.VarChar(255)
  requested_at     DateTime  @default(now()) @db.Timestamp(0)
  approved_at      DateTime? @db.Timestamp(0)
  completed_at     DateTime? @db.Timestamp(0)
  refunded_at      DateTime? @db.Timestamp(0)
  created_at       DateTime  @default(now()) @db.Timestamp(0)
  updated_at       DateTime  @updatedAt @db.Timestamp(0)

  @@map("refunds")
}

model AiFeedback {
  id               Int       @id @default(autoincrement())
  conversation_id  Int?
  message_id       Int?
  user_id          Int?
  rating           Int?
  feedback_text    String?   @db.Text
  correction       String?   @db.Text
  created_at       DateTime  @default(now()) @db.Timestamp(0)

  conversation     Conversation? @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@map("ai_feedback")
  @@index([conversation_id])
  @@index([user_id])
}

model User {
  id          Int      @id @default(autoincrement())
  email       String   @unique @db.VarChar(255)
  password    String   @db.VarChar(255)
  name        String   @db.VarChar(255)
  role        String?  @default("agent") @db.VarChar(50)
  disabled    Boolean? @default(false)
  created_at  DateTime @default(now()) @db.Timestamp(0)
  branch_id   Int?

  branch              Branch? @relation(fields: [branch_id], references: [id], onDelete: SetNull)
  settings            Setting?
  avatars             UserAvatar[]
  profile             StaffProfile?
  voiceSettings       VoiceSettings?

  @@map("users")
  @@index([branch_id])
}

model Setting {
  id            Int     @id @default(autoincrement())
  user_id       Int     @unique
  displayName   String? @db.VarChar(255)
  email         String? @db.VarChar(255)
  password      String? @db.VarChar(255)
  autoReply     String? @db.VarChar(255)
  chatEnabled   String? @db.VarChar(10)
  msgAlert      Boolean?
  ticketAlert   Boolean?
  soundAlert    Boolean?
  priority      String? @db.VarChar(20)
  autoAssign    String? @db.VarChar(10)
  theme         String? @db.VarChar(20)
  translateEnabled Boolean? @db.Boolean @map("translate_enabled")
  translateLang    String? @db.VarChar(10) @map("translate_lang")
  avatarUrl        String? @db.Text @map("avatar_url")
  autopilotMode    String? @db.VarChar(20) @map("autopilotmode")
  aiTone           String? @db.VarChar(20) @map("ai_tone")

  user          User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("settings")
}

model Order {
  id                 Int       @id @default(autoincrement())
  order_id           String?   @unique @db.VarChar(255)
  customer_name      String?   @db.VarChar(255)
  phone              String?   @db.VarChar(255)
  product            String?   @db.Text
  amount             Decimal?  @db.Decimal(10,2)
  total_amount       Decimal?  @db.Decimal(10,2)
  status             String?   @db.VarChar(50)
  order_date         DateTime? @db.Timestamp(0)
  conversation_id    Int?
  voucher_id         Int?
  voucher_code       String?   @db.VarChar(255)
  discount_type      String?   @db.VarChar(50)
  discount_amount    Decimal?  @db.Decimal(10,2)
  subtotal           Decimal?  @db.Decimal(10,2)
  final_total        Decimal?  @db.Decimal(10,2)
  branch_id          Int?
  conversation       Conversation? @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  voucher            Voucher?  @relation(fields: [voucher_id], references: [id], onDelete: SetNull)
  branch             Branch?   @relation(fields: [branch_id], references: [id], onDelete: SetNull)
  deliveries         Delivery[]

  @@map("orders")
  @@index([conversation_id])
  @@index([voucher_id])
  @@index([branch_id])
}

model Delivery {
  id                  Int       @id @default(autoincrement())
  order_id            Int
  rider_name          String?   @db.VarChar(255)
  vehicle             String?   @db.VarChar(128)
  current_lat         Float?
  current_lng         Float?
  customer_lat        Float?
  customer_lng        Float?
  delivery_status     String?   @db.VarChar(64)
  order_confirmed_time DateTime? @db.Timestamp(0)
  rider_assigned_time   DateTime? @db.Timestamp(0)
  picked_up_time        DateTime? @db.Timestamp(0)
  in_transit_time       DateTime? @db.Timestamp(0)
  arriving_time         DateTime? @db.Timestamp(0)
  delivered_time        DateTime? @db.Timestamp(0)
  created_at           DateTime  @default(now()) @db.Timestamp(0)
  updated_at           DateTime  @default(now()) @db.Timestamp(0)
  order                Order     @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@map("deliveries")
  @@index([order_id])
}

model Receipt {
  id         Int      @id @default(autoincrement())
  content    String?  @db.Text
  escalated  Boolean? @db.Boolean
  created_at DateTime @default(now()) @db.Timestamp(0)

  @@map("receipts")
}

model Voucher {
  id                    Int       @id @default(autoincrement())
  code                  String    @unique @db.VarChar(255)
  type                 String    @db.VarChar(50)
  value                Decimal   @db.Decimal(10,2)
  minimum_order        Decimal?  @db.Decimal(10,2)
  minimum_quantity     Int?      @default(0)
  maximum_discount     Decimal?  @db.Decimal(10,2)
  starts_at            DateTime? @db.Timestamp(0)
  expires_at           DateTime? @db.Timestamp(0)
  usage_limit          Int?
  used_count           Int       @default(0)
  per_customer_limit   Int?      @default(0)
  is_active            Boolean   @default(true)
  new_customers_only   Boolean   @default(false)
  applicable_items     String?   @db.Text
  applicable_categories String?  @db.Text
  created_by           Int?
  created_at           DateTime  @default(now()) @db.Timestamp(0)
  updated_at           DateTime  @updatedAt @db.Timestamp(0)
  orders               Order[]
  redemptions          VoucherRedemption[]

  @@map("vouchers")
  @@index([code])
  @@index([is_active])
  @@index([expires_at])
  @@index([starts_at])
}

model VoucherRedemption {
  id               Int      @id @default(autoincrement())
  voucher_id       Int
  voucher_code     String   @db.VarChar(255)
  order_id         String?  @db.VarChar(255)
  customer_id      Int?
  customer_phone   String?  @db.VarChar(255)
  discount_type    String   @db.VarChar(50)
  discount_amount  Decimal  @db.Decimal(10,2)
  subtotal         Decimal  @db.Decimal(10,2)
  final_total      Decimal  @db.Decimal(10,2)
  redeemed_at      DateTime @default(now()) @db.Timestamp(0)
  voucher          Voucher  @relation(fields: [voucher_id], references: [id], onDelete: Cascade)

  @@map("voucher_redemptions")
  @@index([voucher_id])
  @@index([order_id])
  @@index([customer_id])
  @@index([customer_phone])
}

model Ticket {
  id            Int      @id @default(autoincrement())
  ticket_type   String?  @db.VarChar(255)
  subject       String?  @db.VarChar(255)
  customer_name String?  @db.VarChar(255)
  customer_phone String? @db.VarChar(255)
  assignee      String?  @db.VarChar(255)
  priority      String?  @db.VarChar(20)
  status        String?  @db.VarChar(50)
  content       String?  @db.Text
  tags          String?  @db.Text
  attachments   String?  @db.Text
  sla_due       DateTime? @db.Timestamp(0)
  escalated     Boolean? @db.Boolean
  created_at    DateTime  @default(now()) @db.Timestamp(0)
  branch_id     Int?
  branch        Branch?   @relation(fields: [branch_id], references: [id], onDelete: SetNull)
  escalatedTicket EscalatedTicket?

  @@map("tickets")
  @@index([branch_id])
}

model VoiceChannel {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  type      String   @default("BRANCH") @db.VarChar(20)
  branchId  Int?     @map("branch_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(0)

  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@map("voice_channels")
}

model VoiceSettings {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique @map("user_id")
  pushToTalkKey String?  @map("push_to_talk_key") @db.VarChar(50)
  inputDevice   String?  @map("input_device") @db.VarChar(255)
  outputDevice  String?  @map("output_device") @db.VarChar(255)
  inputVolume   Float    @default(1) @map("input_volume")
  outputVolume  Float    @default(1) @map("output_volume")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamp(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("voice_settings")
}

model CustomerFeedback {
  id                Int       @id @default(autoincrement())
  token             String    @unique @db.VarChar(128)
  ticket_id         Int
  customer_id       Int?
  branch_id         Int?
  rating            Int?
  comment           String?   @db.Text
  used              Boolean   @default(false)
  created_at        DateTime  @default(now()) @db.Timestamp(0)
  expires_at        DateTime  @db.Timestamp(0)
  used_at           DateTime? @db.Timestamp(0)
  submitted_at      DateTime? @db.Timestamp(0)
  feedback_source   String?   @db.VarChar(100)
  created_by_staff_id Int?

  @@map("customer_feedback")
  @@index([ticket_id])
  @@index([branch_id])
}

model EscalatedTicket {
  id            Int      @id @default(autoincrement())
  ticket_id     Int      @unique
  ticket        Ticket   @relation(fields: [ticket_id], references: [id], onDelete: Cascade)
  escalated_at  DateTime @default(now()) @db.Timestamp(0)
  escalated_by  String?  @db.VarChar(255)
  reason        String?  @db.Text
  resolved_at   DateTime? @db.Timestamp(0)

  @@map("escalated_tickets")
}

model Food {
  id         Int      @id @default(autoincrement())
  category   String   @db.VarChar(100)
  key_name   String   @db.VarChar(100)
  name       String   @db.VarChar(255)
  price      Decimal  @db.Decimal(10,2)
  available  Int
  image_url  String?  @db.Text
  created_at DateTime @default(now()) @db.Timestamp(0)
  updated_at DateTime @default(now()) @db.Timestamp(0)

  @@map("foods")
  @@unique([category, key_name], name: "uk_category_key")
}

model Menu {
  id         Int      @id @default(autoincrement())
  category   String   @db.VarChar(100)
  key_name   String   @db.VarChar(100)
  name       String   @db.VarChar(255)
  price      Decimal  @db.Decimal(10,2)
  available  Int
  image_url  String?  @db.Text
  created_at DateTime @default(now()) @db.Timestamp(0)
  updated_at DateTime @default(now()) @db.Timestamp(0)
  branch_id  Int?
  branch     Branch?  @relation(fields: [branch_id], references: [id], onDelete: SetNull)
  stockEntries MenuStockEntry[]

  @@map("menu")
  @@unique([category, key_name], name: "uk_category_key")
  @@index([branch_id])
}

model MenuStockEntry {
  id              Int      @id @default(autoincrement())
  menu_id         Int?
  item_name       String   @db.VarChar(255)
  category        String   @db.VarChar(100)
  stock_quantity  Int      @default(0)
  created_at      DateTime @default(now()) @db.Timestamp(0)
  updated_at      DateTime @updatedAt @db.Timestamp(0)
  menu            Menu?    @relation(fields: [menu_id], references: [id], onDelete: SetNull)

  @@map("menu_stock")
  @@unique([category, item_name], name: "uk_menu_stock_item")
  @@index([menu_id])
}

model Table {
  id            Int      @id @default(autoincrement())
  number        Int      @unique
  label         String   @db.VarChar(255)
  status        String   @default("vacant") @db.VarChar(50)
  customerName  String?  @db.VarChar(255) @map("customer_name")
  reservedUntil DateTime? @db.Timestamp(0) @map("reserved_until")
  isBooking     Boolean  @default(false) @map("is_booking")
  created_at    DateTime @default(now()) @db.Timestamp(0)
  updated_at    DateTime @updatedAt @db.Timestamp(0)
  branch_id     Int?
  branch        Branch?  @relation(fields: [branch_id], references: [id], onDelete: SetNull)

  @@map("restaurant_tables")
  @@index([branch_id])
}

model WhatsappToken {
  id         Int      @id @default(autoincrement())
  token      String?  @db.Text
  expires_at DateTime?
  created_at DateTime @default(now()) @db.Timestamp(0)

  @@map("whatsapp_tokens")
}

model UserAvatar {
  id         Int      @id @default(autoincrement())
  user_id    Int
  filename   String   @db.VarChar(255)
  url        String   @db.Text
  created_at DateTime @default(now()) @db.Timestamp(0)
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("user_avatars")
  @@index([user_id])
}

model DeliveryIssue {
  id               Int       @id @default(autoincrement())
  conversation_id  Int
  customer_name    String?   @db.VarChar(255)
  reported_at      DateTime  @default(now()) @db.Timestamp(0)

  conversation     Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@map("delivery_issues")
  @@index([conversation_id])
}

model Email {
  id            Int       @id @default(autoincrement())
  from          String    @db.VarChar(255)
  fromEmail     String    @db.VarChar(255)
  to            String    @db.VarChar(255)
  subject       String    @db.VarChar(255)
  body          String    @db.Text
  preview       String?   @db.Text
  date          DateTime? @db.Timestamp(0)
  isRead        Boolean   @default(false)
  isImportant   Boolean   @default(false)
  isArchived    Boolean   @default(false)
  isSpam        Boolean   @default(false)
  created_at    DateTime  @default(now()) @db.Timestamp(0)
  updated_at    DateTime  @updatedAt @db.Timestamp(0)

  @@map("emails")
  @@index([fromEmail])
  @@index([to])
  @@index([created_at])
}

model StaffProfile {
  id              Int       @id @default(autoincrement())
  user_id         Int       @unique
  firstName        String?   @db.VarChar(255)
  lastName         String?   @db.VarChar(255)
  email           String?   @db.VarChar(255)
  phone           String?   @db.VarChar(255)
  bio             String?   @db.Text
  country         String?   @db.VarChar(255)
  cityState       String?   @db.VarChar(255)
  postalCode      String?   @db.VarChar(255)
  taxId           String?   @db.VarChar(255)
  avatarUrl       String?   @db.Text
  created_at      DateTime  @default(now()) @db.Timestamp(0)
  updated_at      DateTime  @default(now()) @updatedAt @db.Timestamp(0)
  branch_id       Int?

  user            User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  branch          Branch?   @relation(fields: [branch_id], references: [id], onDelete: SetNull)

  @@map("staff_profiles")
  @@index([user_id])
  @@index([branch_id])
}

model DashboardSnapshot {
  id         Int      @id @default(autoincrement())
  name       String   @unique @db.VarChar(64)
  data       Json?
  updated_at DateTime @updatedAt @db.Timestamp(0)

  @@map("dashboard_snapshots")
}

model PasswordReset {
  id        Int      @id @default(autoincrement())
  email     String   @db.VarChar(255)
  token     String   @unique @db.VarChar(255)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now()) @db.Timestamp(0)

  @@map("password_resets")
  @@index([email])
  @@index([token])
}

